{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lovelace",
  "version": "0.2.1",
  "identifier": "app.lovelace.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lovelace",
        "create": false,
        "width": 1100,
        "height": 760,
        "minWidth": 680,
        "minHeight": 520
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "main",
          "windows": ["main"],
          "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]
        }
      ],
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; media-src asset: http://asset.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
